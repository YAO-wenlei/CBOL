<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.cbol.dao.mapper.GameMapper">

    <resultMap id="baseMap" type="org.cbol.dto.GameInfoDTO">
        <id column="id" property="id" jdbcType="BIGINT"></id>
        <result column="title" property="title" jdbcType="VARCHAR"></result>
        <result column="playbill_url" property="playbillUrl" jdbcType="VARCHAR"></result>
        <result column="home_team_id" property="homeTeamId" jdbcType="BIGINT"></result>
        <result column="guest_team_id" property="guestTeamId" jdbcType="BIGINT"></result>
        <result column="arena_id" property="arenaId" jdbcType="BIGINT"></result>
        <result column="start_time" property="startTime"></result>
        <result column="end_time" property="endTime"></result>
        <result column="start_sale_time" property="startSaleTime"></result>
        <result column="stop_sale_time" property="stopSaleTime"></result>
        <result column="name" property="arenaName" jdbcType="VARCHAR"></result>
    </resultMap>

    <select id="getGameInfoDTOById" resultMap="baseMap" parameterType="long">
        SELECT
            t1.id,
            t1.title,
            t1.playbill_url,
            t1.home_team_id,
            t1.guest_team_id,
            t1.arena_id,
            t1.start_time,
            t1.end_time,
            t2.start_sale_time,
            t2.stop_sale_time,
            t3.name
        FROM t_game t1
        LEFT JOIN t_arena_seat t2 ON t1.id = t2.game_id
        LEFT JOIN t_arena t3 ON t1.arena_id = t3.id
        WHERE t1.id = #{id}
    </select>
    <select id="pageQuery" resultMap="baseMap" parameterType="org.cbol.vo.game.GamePageQueryVO">
        SELECT
            t1.id,
            t1.title,
            t1.playbill_url,
            t1.home_team_id,
            t1.guest_team_id,
            t1.arena_id,
            t1.start_time,
            t1.end_time,
            t2.start_sale_time,
            t2.stop_sale_time,
            t3.name
        FROM t_game t1
        LEFT JOIN t_arena_seat t2 ON t1.id = t2.game_id
        LEFT JOIN t_arena t3 ON t1.arena_id = t3.id
        <where>
            <if test="gamePageQueryVO.areanId != null and gamePageQueryVO.areanId != '' ">
                AND t1.arena_id = #{gamePageQueryVO.areanId}
            </if>
            <if test="gamePageQueryVO.clubId != null and gamePageQueryVO.clubId != '' ">
                AND (t1.home_team_id = #{gamePageQueryVO.clubId} OR t1.guest_team_id = #{gamePageQueryVO.clubId})
            </if>
            <if test="gamePageQueryVO.startTime != null and gamePageQueryVO.startTime!= '' ">
                AND t1.start_time = #{gamePageQueryVO.startTime}
            </if>
        </where>
    </select>
</mapper>
